rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function superAdmin() { return request.auth != null && request.auth.token.email == 'shok.shayke@gmail.com' && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
  function manager() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com' && (superAdmin() || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)); }
  match /admins/{uid} {
   allow read: if superAdmin() || (request.auth != null && request.auth.uid == uid);
   allow create, update: if superAdmin() && request.resource.data.keys().hasOnly(['active','createdAt']) && request.resource.data.active is bool && request.resource.data.createdAt == request.time;
   allow delete: if superAdmin();
  }
  match /reservations/{seatId} {
   allow read: if true;
   allow create: if request.auth != null
    && ((seatId.matches('(B05|B06|B07|B08|B09|B10|B11|B12|B13|B14|B15|B16|B17|B18|B19|B20|B21|B22|B23|B24|B25|B26|B27|B28|B29|B30|B31|B32|B33|B34|B35|B36|B37|B38|B39|B40|B41|B42|B43|B44|B45|B46|B47|B48|B49|B50)-S[1-4]')) || (seatId.matches('(B01|B02|B03|B04)-S[1-6]')))
    && request.resource.data.keys().hasOnly(['displayName','familyName','ownerUid','residentConfirmed','gradeConfirmed','createdAt'])
    && (manager() || request.resource.data.ownerUid == request.auth.uid)
    && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 70
    && request.resource.data.familyName is string && request.resource.data.familyName.size() > 0 && request.resource.data.familyName.size() <= 70
    && request.resource.data.residentConfirmed == true && request.resource.data.gradeConfirmed == true
    && request.resource.data.createdAt == request.time;
   allow delete: if manager() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
   allow update: if manager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']) && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 70;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
